<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% color_classes = type.to_s == "notice" ? "border-green-200/80 bg-green-50 text-green-700" : "border-rose-200/80 bg-rose-50 text-rose-700" %>
  <div class="flex items-start gap-3 rounded-lg border px-4 py-3 text-sm shadow-sm <%= color_classes %>" role="alert">
    <svg class="mt-0.5 h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <% if type.to_s == "notice" %>
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      <% else %>
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 3h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L4.34 16c-.77 1.333.192 3 1.732 3z" />
      <% end %>
    </svg>
    <p><%= message %></p>
  </div>
<% end %>
