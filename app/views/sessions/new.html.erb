<% provide :title, t("sessions.new.title") %>

<div class="grid min-h-screen lg:grid-cols-2">
  <div class="flex flex-col justify-center px-6 py-16 sm:px-12 lg:px-24">
    <div class="mx-auto w-full max-w-md space-y-10">
      <div class="space-y-2 text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= t("sessions.new.welcome") %></p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900"><%= t("sessions.new.headline") %></h1>
        <p class="text-sm text-slate-600"><%= t("sessions.new.description") %></p>
      </div>

      <div class="space-y-4">
        <%= render "shared/flash" %>

        <%= form_with url: session_path, class: "space-y-6" do |form| %>
          <% input_classes = "flex h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 transition" %>

          <div class="space-y-2">
            <%= form.label :email_address, t("sessions.new.email_label"), class: "text-sm font-medium text-slate-700" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("sessions.new.email_placeholder"), value: params[:email_address], class: input_classes %>
          </div>

          <div
            class="space-y-2"
            data-controller="password-visibility"
            data-password-visibility-show-label-value="<%= t("auth.password_visibility.show") %>"
            data-password-visibility-hide-label-value="<%= t("auth.password_visibility.hide") %>"
          >
            <div class="flex items-center justify-between">
              <%= form.label :password, t("sessions.new.password_label"), class: "text-sm font-medium text-slate-700" %>
              <%= link_to t("sessions.new.forgot_password"), new_password_path, class: "text-sm font-medium text-slate-600 underline-offset-4 hover:text-slate-900 hover:underline" %>
            </div>
            <div class="relative">
              <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, placeholder: t("sessions.new.password_placeholder"), class: input_classes, data: { password_visibility_target: "input" } %>
              <button type="button" class="absolute inset-y-0 right-0 flex items-center px-3 text-sm font-medium text-slate-600 hover:text-slate-900" data-action="password-visibility#toggle">
                <span data-password-visibility-target="label"><%= t("auth.password_visibility.show") %></span>
              </button>
            </div>
          </div>

          <div class="space-y-4">
            <%= form.submit t("sessions.new.submit"), class: "inline-flex w-full items-center justify-center rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2" %>
          </div>
        <% end %>
      </div>

      <p class="text-center text-sm text-slate-600">
        <%= t("sessions.new.no_account") %>
        <%= link_to t("sessions.new.sign_up"), new_registration_path, class: "font-medium text-slate-900 underline-offset-4 hover:underline" %>
      </p>
    </div>
  </div>

  <div class="relative hidden bg-slate-900 lg:block">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(148,163,184,0.35),_transparent_60%),radial-gradient(circle_at_bottom,_rgba(15,23,42,0.8),_rgba(15,23,42,1))]"></div>
    <div class="relative flex h-full flex-col justify-between p-16 text-slate-100">
      <div class="space-y-4">
        <span class="inline-flex items-center rounded-full bg-slate-800/70 px-3 py-1 text-xs font-medium uppercase tracking-wide"><%= t("sessions.new.badge") %></span>
        <h2 class="text-3xl font-semibold tracking-tight"><%= t("sessions.new.promo_heading") %></h2>
        <p class="max-w-sm text-sm text-slate-300"><%= t("sessions.new.promo_text") %></p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
        <p class="text-sm text-slate-200"><%= t("sessions.new.quote") %></p>
        <div class="mt-4 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-800 text-sm font-semibold">SU</span>
          <div>
            <p class="text-sm font-semibold text-white"><%= t("sessions.new.quote_author") %></p>
            <p class="text-xs text-slate-300"><%= t("sessions.new.quote_role") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
